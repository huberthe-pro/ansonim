---
import { PageMetadata } from "@/src/components/hybrid-astro-ui/page-metadata";
import OGImage from "@/src/assets/background.png"
import type { ImageMetadata } from "astro";

interface Props {
	title: string;
	description: string;
	locale?: string;
	alternateLinks?: { href: string; hreflang: string }[];
	image?: ImageMetadata | string;
	ogType?: "website" | "article";
}

const { title, description, locale = "en", alternateLinks, image = OGImage, ogType = "website" } = Astro.props;
---

<!doctype html>
<html lang={locale} class="dark">
	<head>
		<PageMetadata
			lang={locale}
			title={title}
			description={description}
			image={image}
			enableClientRouter
			ogType={ogType}
			favicons={[{ rel: "icon", type: "image/png", href: "/icon.png", sizes: "32x32" }]}
			alternateLinks={alternateLinks}
		/>
	</head>
	<body class="flex flex-col items-center w-full font-mono px-5 md:px-0 leading-7">
		<slot />
	</body>
</html>
